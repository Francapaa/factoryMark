# Copiar a backend/.env y frontend/.env.local según corresponda.
# Nunca commitear valores reales.

# Google Places (backend) — cuota inicial $20, usar con cache
GOOGLE_PLACES_API_KEY=

# LLM para Strategist/Creator (verbalización y copy, no para inventar temas)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Frontend → backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Neon Auth (login solo con Google) — ver frontend/.env.local.example y backend/.env.example.
# En Neon Console → Auth: copiar NEON_AUTH_BASE_URL y generar NEON_AUTH_COOKIE_SECRET.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
DATABASE_URL=
