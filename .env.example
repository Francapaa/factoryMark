# Copiar a backend/.env y frontend/.env.local según corresponda.
# Nunca commitear valores reales.

# Google Places (backend) — cuota inicial $20, usar con cache
GOOGLE_PLACES_API_KEY=

# LLM para Strategist/Creator (verbalización y copy, no para inventar temas)
