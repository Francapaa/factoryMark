# URL pública del backend FastAPI (para fetch desde el browser/server)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Neon Auth (login solo con Google) — copiar a .env.local con valores reales.
# Se obtienen en Neon Console → tu proyecto → Auth.
# Google funciona en dev con credenciales compartidas; en prod cargá tu
# Client ID/Secret y el redirect {NEON_AUTH_BASE_URL}/callback/google.
NEON_AUTH_BASE_URL=
# Secreto de 32+ caracteres para firmar cookies de sesión (generar con: openssl rand -base64 32)
NEON_AUTH_COOKIE_SECRET=
# Opcional: conexión a Neon Postgres (el auth vive en el schema neon_auth)
DATABASE_URL=
