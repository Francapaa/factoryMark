# Copiar a .env (nunca commitear el real)
GOOGLE_PLACES_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Neon Auth (login solo con Google) — valores en Neon Console → Auth
NEON_AUTH_BASE_URL=
# Opcional: por defecto es NEON_AUTH_BASE_URL + /.well-known/jwks.json
NEON_AUTH_JWKS_URL=
# Solo dev local sin Neon (nunca en prod)
AUTH_DISABLED=false
