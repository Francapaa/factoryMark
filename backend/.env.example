# Copiar a .env (nunca commitear el real)
GOOGLE_PLACES_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Radio de búsqueda por proximidad en modo local (metros)
SEARCH_RADIUS_M=1000

# Tavily (señales web: obligatorio en canal online/mixto, opcional en local)
TAVILY_API_KEY=
TAVILY_ENABLED=false
TAVILY_MAX_QUERIES=3
TAVILY_MAX_RESULTS=5

# Neon Auth (login solo con Google) — valores en Neon Console → Auth
NEON_AUTH_BASE_URL=
# Opcional: por defecto es NEON_AUTH_BASE_URL + /.well-known/jwks.json
NEON_AUTH_JWKS_URL=
# Solo dev local sin Neon (nunca en prod)
AUTH_DISABLED=false

# Neon Postgres (negocio del dueño, DDL versionado en backend/migrations)
DATABASE_URL=
# Solo tests de integración: rama/base separada de la de producción
TEST_DATABASE_URL=
# Opcional: override del directorio de caché de Places/Tavily (tests usan tmp)
PLACES_CACHE_DIR=
# Instagram-Login v2 (flavor Instagram, scopes basic + content_publish)
# El redirect apunta a la ruta Next que puentea al dashboard
# (frontend/src/app/api/instagram/callback). Los secretos viven solo en backend.
# Programadas: cola propia en app.publicaciones (migración 0001_baseline);
# aplicar DDL con: uv run alembic upgrade head (desde backend/, manual)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
TOKEN_ENCRYPTION_KEY=
