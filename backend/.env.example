# Copiar a .env (nunca commitear el real)
GOOGLE_PLACES_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Radio de búsqueda por proximidad en modo local (metros)
SEARCH_RADIUS_M=1000

# Tavily (señales web: obligatorio en canal online/mixto, opcional en local)
TAVILY_API_KEY=
TAVILY_ENABLED=false
TAVILY_MAX_QUERIES=3
TAVILY_MAX_RESULTS=5

# Neon Auth (login solo con Google) — valores en Neon Console → Auth
NEON_AUTH_BASE_URL=
# Opcional: por defecto es NEON_AUTH_BASE_URL + /.well-known/jwks.json
NEON_AUTH_JWKS_URL=
# Solo dev local sin Neon (nunca en prod)
AUTH_DISABLED=false

# Instagram-Login v1 (flavor Instagram, scope instagram_business_basic)
# Publicar queda tras App Review (milestone separado)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/instagram/callback
TOKEN_ENCRYPTION_KEY=
